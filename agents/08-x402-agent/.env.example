# Test wallet only. Never use a wallet containing real funds.
EVM_PRIVATE_KEY=0x_your_base_sepolia_test_wallet_private_key

# Optional. You can also provide the resource URL when starting the agent.
X402_RESOURCE_URL=

# Payment safety rules
X402_MAX_PAYMENT_USD=0.10
X402_ALLOWED_NETWORKS=eip155:84532
X402_ALLOWED_ASSETS=USDC
X402_ALLOWED_RECIPIENTS=
X402_AUTO_APPROVE=false

# Local payment record
X402_LOG_PATH=./data/payments.jsonl

# Local paid-resource example
X402_SERVER_PAY_TO=0x_your_base_sepolia_receiver_address
X402_SERVER_PORT=4021
