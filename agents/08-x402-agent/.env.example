# Disposable test wallet used by the payment agent.
# Never use a wallet containing real funds.
EVM_PRIVATE_KEY=0x_your_disposable_payer_private_key

# Optional default paid resource.
# You can also pass the URL to npm start.
X402_RESOURCE_URL=http://localhost:4021/weather/avalanche

# Payment safety rules
X402_MAX_PAYMENT_USD=0.10
X402_ALLOWED_NETWORKS=eip155:84532,eip155:43113
X402_ALLOWED_ASSETS=USDC
X402_ALLOWED_RECIPIENTS=
X402_AUTO_APPROVE=false

# Local payment record
X402_LOG_PATH=./data/payments.jsonl

# Local facilitator
X402_FACILITATOR_URL=http://127.0.0.1:4022
X402_FACILITATOR_PORT=4022

# One disposable facilitator wallet can be used on both networks.
# It needs Base Sepolia ETH to settle Base payments.
# It needs Fuji AVAX to settle Avalanche payments.
X402_FACILITATOR_PRIVATE_KEY=0x_your_disposable_facilitator_private_key

# Optional separate facilitator wallets per network.
# These override X402_FACILITATOR_PRIVATE_KEY when supplied.
X402_BASE_FACILITATOR_PRIVATE_KEY=
X402_FUJI_FACILITATOR_PRIVATE_KEY=

# RPC endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Local paid-resource server
X402_SERVER_PAY_TO=0x_your_test_receiver_address
X402_SERVER_PORT=4021
